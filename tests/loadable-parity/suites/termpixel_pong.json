{
  "version": 1,
  "loadable": "termpixel_pong",
  "reference": "No GNU/POSIX CLI implements this interactive Bash loadable. Runnable cases are Bash metadata contracts or documented loadable contracts. Dump-frame expected bytes come from an independent Python encoder: it constructs the documented 80x80 RGB initial scene and emits each 80x40 terminal row with ANSI 24-bit foreground/background changes and U+2580 upper-half blocks. The independently encoded default frame is 7,391 bytes, matching the historical status record; no candidate output was used to build the oracle.",
  "coverage": [
    "Bash builtin registration and help metadata",
    "Initial two-player and AI dump frames with independent byte encodings",
    "AI/two-player option precedence, seed and no-sound parsing",
    "Invalid difficulty and unknown-option rejection",
    "Bounded selftest exit and output presence"
  ],
  "exclusions": [
    "No GNU parity CLI exists for termpixel_pong; no parity cases are claimed.",
    "Interactive movement, scoring, pause, restart, AI dynamics, pacing, and terminal restoration are deferred because they require a PTY and controlled clock.",
    "The live UI is not exercised; metadata cases do not count as operation coverage."
  ],
  "cases": [
    {
      "id": "bash-type",
      "kind": "contract",
      "purpose": "Confirms the loadable is registered as a Bash builtin using the documented Bash type contract; metadata only.",
      "script": "type -t termpixel_pong",
      "expected_status": 0,
      "stdout": "builtin\n",
      "stderr": "empty"
    },
    {
      "id": "bash-help-options",
      "kind": "contract",
      "purpose": "Checks the Bash help entry advertises the documented AI, two-player, timing, frame, seed, dump, and selftest options.",
      "script": "doc=$(help termpixel_pong)\n[[ $doc == *'--ai[=easy|medium|hard]'* ]]\n[[ $doc == *'--two-player'* && $doc == *'--fps N'* ]]\n[[ $doc == *'--frames N'* && $doc == *'--seed N'* && $doc == *'--winning-score N'* ]]\n[[ $doc == *'--dump-frame'* && $doc == *'--selftest'* ]]\nprintf 'documented help options present\\n'",
      "expected_status": 0,
      "stdout": "documented help options present\n",
      "stderr": "empty"
    },
    {
      "id": "dump-frame-default",
      "kind": "contract",
      "purpose": "Compares the initial two-player dump byte-for-byte with an independent RGB canvas and ANSI truecolor half-block encoder.",
      "script": "termpixel_pong --dump-frame",
      "expected_status": 0,
      "stdout_base64": "",
      "stderr": "empty"
    },
    {
      "id": "dump-frame-ai",
      "kind": "contract",
      "purpose": "Checks the initial AI HUD and frame encoding using the independent encoder; seed does not affect initial visible state.",
      "script": "termpixel_pong --ai=easy --dump-frame --seed 123",
      "expected_status": 0,
      "stdout_base64": "",
      "stderr": "empty"
    },
    {
      "id": "dump-frame-mode-override",
      "kind": "contract",
      "purpose": "Checks that a later --two-player selection restores the two-player HUD after --ai; also covers --no-sound and a non-default seed.",
      "script": "termpixel_pong --ai=hard --two-player --dump-frame --seed 42 --no-sound",
      "expected_status": 0,
      "stdout_base64": "",
      "stderr": "empty"
    },
    {
      "id": "reject-invalid-ai",
      "kind": "contract",
      "purpose": "An unsupported AI difficulty must fail, emit a diagnostic, and produce no frame; the contract does not pin the wording or exact nonzero status.",
      "script": "rc=0\ntermpixel_pong --ai=impossible --dump-frame >invalid.out || rc=$?\n[[ $rc -ne 0 && ! -s invalid.out ]]\nprintf 'invalid difficulty rejected\\n'",
      "expected_status": 0,
      "stdout": "invalid difficulty rejected\n",
      "stderr": "nonempty"
    },
    {
      "id": "reject-unknown-option",
      "kind": "contract",
      "purpose": "An unknown option must fail with a diagnostic and no rendered frame; no undocumented status number or diagnostic wording is assumed.",
      "script": "rc=0\ntermpixel_pong --unknown-option >unknown.out || rc=$?\n[[ $rc -ne 0 && ! -s unknown.out ]]\nprintf 'unknown option rejected\\n'",
      "expected_status": 0,
      "stdout": "unknown option rejected\n",
      "stderr": "nonempty"
    },
    {
      "id": "selftest-smoke",
      "kind": "contract",
      "purpose": "Documented bounded selftest completes thirty deterministic updates and a render, reporting its explicit success marker. Initial frame contracts independently check rendering; this selftest does not establish gameplay correctness.",
      "script": "termpixel_pong --selftest",
      "expected_status": 0,
      "stdout": "termpixel_pong selftest OK\n",
      "stderr": "empty"
    },
    {
      "id": "two-player-interaction",
      "kind": "deferred",
      "purpose": "Live paddle movement, pause, serve delay, scoring, win condition, and restart need injected keyboard events and controlled elapsed time.",
      "reason": "DEFERRED: run only in a future disposable VM with a PTY input driver and controllable monotonic clock. The current fixture runner has no PTY event/clock API, and a pipe-driven --frames case cannot provide stable gameplay reference results."
    },
    {
      "id": "ai-and-terminal-loop",
      "kind": "deferred",
      "purpose": "AI reaction/accuracy behavior and raw-terminal key handling require a live terminal loop with deterministic frame timing.",
      "reason": "DEFERRED: requires a future disposable VM or reviewed terminal/clock mock that can inject keys, control frame timing, and inspect terminal restoration. No interactive operation is executed here."
    }
  ]
}
