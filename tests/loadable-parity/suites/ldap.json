{
  "version": 1,
  "loadable": "ldap",
  "reference": "Bash type/help metadata contract and independent LDAPv3 BER/filter wire-format vectors from RFC 4511. Encoder expectations below were hand-encoded from the protocol tags, lengths, and request fields; no candidate output is used. No matching ldapsearch reference CLI is available for this suite.",
  "coverage": [
    "Bash builtin discovery and the loadable's documented help text",
    "Simple-bind request BER with nonempty DN and password",
    "Equality filter encoding",
    "AND filter encoding with a hex-escaped literal asterisk and a presence assertion",
    "Substring filter encoding with initial and final components",
    "Search request BER with base DN, default subtree scope, equality filter, and two requested attributes",
    "Malformed unterminated filter rejection",
    "Offline OR/NOT encoding and valid multi-value search-entry/result decoding from independently encoded RFC 4511 vectors."
  ],
  "exclusions": [
    "No ldapsearch executable or equivalent GNU CLI is available, so runnable cases are documented-contract checks rather than GNU parity comparisons.",
    "Network search, bind, WhoAmI, LDAPS, and StartTLS need a controlled disposable LDAP/TLS peer; those operations are explicitly deferred below.",
    "Interactive password prompting with -W needs a disposable PTY and is not exercised."
  ],
  "cases": [
    {
      "id": "bash-metadata",
      "purpose": "Confirm ldap is registered as a Bash builtin and help exposes the documented LDAPv3 client and supported operation/filter summary.",
      "kind": "contract",
      "script": "[[ $(type -t ldap) == builtin ]]\nhelp_text=$(help ldap)\n[[ $help_text == *'Small LDAPv3 BER client for bash-os NSS and userdb providers.'* ]]\n[[ $help_text == *'Supported filters: equality, present, and/or/not, and substring.'* ]]\n[[ $help_text == *'Supported operations: simple bind, search, StartTLS, and WhoAmI.'* ]]\nprintf 'builtin\\nhelp documented\\n'",
      "expected_status": 0,
      "stdout": "builtin\nhelp documented\n",
      "stderr": "empty"
    },
    {
      "id": "bind-ber-vector",
      "purpose": "Check the simple-bind LDAPMessage against an independent BER encoding: message ID 1, LDAP version 3, the supplied DN, and simple authentication bytes.",
      "kind": "contract",
      "script": "ldap encode-test bind 'cn=alice,dc=example' 's3cret'",
      "expected_status": 0,
      "stdout": "302502010160200201030413636e3d616c6963652c64633d6578616d706c658006733363726574\n",
      "stderr": "empty"
    },
    {
      "id": "equality-filter-vector",
      "purpose": "Check the RFC 4511 equalityMatch filter TLV for attribute uid and assertion value fixture.",
      "kind": "contract",
      "script": "ldap filter-test '(uid=fixture)'",
      "expected_status": 0,
      "stdout": "a30e0403756964040766697874757265\n",
      "stderr": "empty"
    },
    {
      "id": "compound-escaped-filter-vector",
      "purpose": "Check an AND filter containing an equality assertion whose escaped \\2a decodes to a literal asterisk, plus a present assertion; expected bytes follow the RFC 4511 filter alternatives.",
      "kind": "contract",
      "script": "ldap filter-test '(&(uid=ann\\2ab)(objectClass=*))'",
      "expected_status": 0,
      "stdout": "a01ba30c04037569640405616e6e2a62870b6f626a656374436c617373\n",
      "stderr": "empty"
    },
    {
      "id": "substring-filter-vector",
      "purpose": "Check a substring filter with initial component al and final component ce, encoded using the RFC 4511 initial and final substring tags.",
      "kind": "contract",
      "script": "ldap filter-test '(cn=al*ce)'",
      "expected_status": 0,
      "stdout": "a40e0402636e30088002616c82026365\n",
      "stderr": "empty"
    },
    {
      "id": "search-request-ber-vector",
      "purpose": "Check the independently encoded LDAP SearchRequest envelope, including subtree scope, zero limits, false typesOnly, equality filter, and ordered attribute selection.",
      "kind": "contract",
      "script": "ldap encode-test search 'dc=ex' '(cn=x)' cn mail",
      "expected_status": 0,
      "stdout": "3030020102632b040564633d65780a01020a0100020100020100010100a3070402636e040178300a0402636e04046d61696c\n",
      "stderr": "empty"
    },
    {
      "id": "unterminated-filter-rejected",
      "purpose": "Check that a filter missing its closing parenthesis is rejected with failure and a diagnostic, as required by the filter grammar.",
      "kind": "contract",
      "script": "ldap filter-test '(uid=fixture'",
      "expected_status": 1,
      "stdout": "",
      "stderr": "nonempty"
    },
