      "id": "migration-terminal213-top-delay-invalid",
      "kind": "contract",
      "loadable": "top",
      "oracle": "BashOS top documented interactive controls over an independently encoded private proc(5) snapshot; xterm/ECMA-48 controls and PTY modes are decoded independently by the harness.",
      "purpose": "n then 0 Enter is rejected without changing the interval.",
      "requires": [
        "unshare",
        "mount",
        "python3"
      ],
      "restore_terminal": true,
      "script": "/usr/bin/python3 /opt/bashos-parity/harness/helpers/terminal213_guard.py || { printf \"TERMINAL213-INFRA\\n\" >&2; exit 90; }\nexec /usr/bin/unshare --user --map-root-user --mount \"$BASH\" --noprofile --norc -c '/usr/bin/mount -n --bind \"$PWD/snap\" /proc || { printf \"TERMINAL213-INFRA\\n\" >&2; exit 91; }; top -d 2'",
      "setup_script": "/usr/bin/python3 /opt/bashos-parity/harness/helpers/terminal213_guard.py\n/usr/bin/unshare --user --map-root-user --mount /bin/bash --noprofile --norc -c '/usr/bin/mount -n --bind \"$PWD/snap\" /proc || exit 91; [[ $(< /proc/loadavg) == \"0.25 0.50 1.00 1/30 130\" ]] || exit 92'",
      "size": [
        24,
        80
      ],
      "steps": [
        {
          "screen": {
            "rows": {
              "0": "top.*procs 30.*sort CPU",
              "4": "^\\s*130\\s"
            }
          }
        },
        {
          "send": "n"
        },
        {
          "screen": {
            "contains": [
              "delay \\(s\\):"
            ]
          }
        },
        {
          "send": "0\r"
        },
        {
          "screen": {
            "contains": [
              "invalid delay"
            ]
          }
        },
        {
          "screen": {
            "rows": {
              "0": "every 2s"
            }
          }
        },
        {
          "send": "q"
        }
      ],
      "timeout": 20
    },
