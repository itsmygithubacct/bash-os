{
  "schema": 1,
  "cases": [
    {
      "id": "worker-nano-utf8-save-burst",
      "loadable": "nano",
      "group": "terminal",
      "driver": "pty",
      "purpose": "Save UTF-8 burst in an empty file with the default final newline.",
      "script": "nano note",
      "steps": [
        {
          "screen": {
            "contains": [
              "note"
            ]
          }
        },
        {
          "termios": {
            "clear": [
              "ECHO",
              "ICANON"
            ]
          }
        },
        {
          "send": "\u00e9\u4e2dx"
        },
        {
          "settle_ms": 150
        },
        {
          "send": "\u0013"
        },
        {
          "settle_ms": 150
        },
        {
          "send": "\u0018"
        },
        {
          "settle_ms": 150
        }
      ],
      "expected_status": 0,
      "covers": [
        "nano/deferred_selection_completion_utf8"
      ],
      "files": {
        "note": ""
      },
      "expected_files": {
        "note": "\u00e9\u4e2dx\n"
      }
    },
