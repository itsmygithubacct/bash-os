      "id": "migration-ptybroker-lifecycle-raw-exit",
      "loadable": "ptybroker",
      "group": "shell",
      "driver": "plain",
      "kind": "contract",
      "purpose": "Raw capture, late attachment, final output ordering, and retained exit status.",
      "covers": [
        "ptybroker/raw_history_and_late_attach",
        "ptybroker/child_exit_and_cleanup"
      ],
      "oracle": "Each guest setup records staged filesystem, seqpacket, monotonic clock, parser controls and exact PTY handshake. Cleanup additionally controls FIFO, proc/pidfd, positive/negative ordering and subreaper adoption. Candidate preconditions and the observer record are checked independently for each run. Primary must apply the pinned proposed primary gate, after independent review; generic runner status alone is not sufficient.",
      "comparison": "Require exact fixed history bytes, no replay, contiguous output offsets, attached and gap offsets, final output preceding exit, and status 37 after child exit.",
      "requires": [
        "python3",
        "stat",
        "mkdir",
        "cat",
        "sleep"
      ],
      "setup_script": "/usr/bin/python3 -I /opt/bashos-parity/harness/helpers/ptybroker-lifecycle-reviewed.py setup\n",
      "candidate_script": "source /opt/bashos-parity/harness/helpers/ptybroker-lifecycle-reviewed.sh\n",
      "stdout": "raw-exit-ok\n",
      "stderr": "",
      "expected_status": 0,
      "timeout": 60,
      "setup_timeout": 35,
