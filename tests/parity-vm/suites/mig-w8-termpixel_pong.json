    {
      "id": "mig-w8-pong-raw-mode-esc",
      "loadable": "termpixel_pong",
      "group": "terminal",
      "driver": "pty",
      "purpose": "The live loop draws the court, puts the terminal in raw mode (canonical input and echo off) and leaves with status 0 and canonical echoing mode restored when ESC is pressed.",
      "script": "termpixel_pong --two-player --seed 1",
      "steps": [
        {
          "screen": {
            "cells": [
              {
                "row": 17,
                "col": 5,
                "fg": "ffffff",
                "bg": "ffffff"
              },
              {
                "row": 20,
                "col": 5,
                "fg": "ffffff",
                "bg": "ffffff"
              },
              {
                "row": 22,
                "col": 5,
                "fg": "ffffff",
                "bg": "ffffff"
              },
              {
                "row": 17,
                "col": 6,
                "fg": "ffffff",
                "bg": "ffffff"
              },
              {
                "row": 22,
                "col": 6,
                "fg": "ffffff",
                "bg": "ffffff"
              }
            ]
          }
        },
        {
          "termios": {
            "clear": [
              "ICANON",
              "ECHO"
            ]
          }
        },
        {
          "key": "escape"
        },
        {
          "termios": {
            "set": [
              "ICANON",
              "ECHO"
            ]
          }
        }
      ],
      "size": [
        42,
        82
      ],
      "expected_status": 0,
      "covers": [
        "termpixel_pong/ai-and-terminal-loop"
      ],
      "kind": "contract",
      "oracle": "Documented termpixel_pong rules (80x80 pixel canvas drawn two pixels per cell: left paddle x=5..6, y=34..45 initially, right paddle x=73..74, 12 pixels tall, paddle speed 100 px/s clamped to the court, serve delay 1 s) and the pyte terminal model decoding the half-block colour cells (a white pixel pair = cell fg and bg ffffff). Clamping at the court edge makes the end position independent of frame timing.",
      "comparison": "Initial left paddle cells white; ICANON/ECHO cleared while running and set after ESC; status 0; the harness also compares the full termios before and after.",
      "timeout": 25
    },
