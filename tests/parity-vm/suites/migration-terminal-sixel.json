{
  "schema": 1,
  "cases": [
    {
      "id": "migration-sixel-terminal-pixel-size",
      "loadable": "sixel",
      "group": "terminal",
      "driver": "pty",
      "kind": "contract",
      "covers": [
        "sixel/resize-and-terminal-defaults"
      ],
      "purpose": "With the terminal reporting 640x384 pixels (TIOCSWINSZ by a helper), sixel without -w uses 640 px width and keeps the 4:7 aspect (1120 px high); -H 10 keeps the terminal width; -w 8 derives height 14",
      "oracle": "contract: sixel help text ('-w N output width in pixels (default: terminal px, else 800)', '-H N output height in pixels (default: keep aspect)') and DEC sixel raster attributes \"Pan;Pad;Ph;Pv",
      "comparison": "exact raster-attribute bytes in the raw PTY output, in order",
      "requires": [
        "python3"
      ],
      "timeout": 20,
      "files": {
        "img.tga": {
          "base64": "AAACAAAAAAAAAAAABAAHABggAAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/"
        },
        "wide.tga": {
          "base64": ""
        },
        "setpx.py": "import fcntl, os, struct, sys, termios\nfd = os.open('/dev/tty', os.O_RDWR | os.O_NOCTTY)\nfcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', 24, 80, int(sys.argv[1]), int(sys.argv[2])))\nos.close(fd)\n"
      },
      "script": "/usr/bin/python3 setpx.py 640 384\nsixel img.tga\nprintf '\\n=1=\\n'\nsixel -H 10 img.tga\nprintf '\\n=2=\\n'\nsixel -w 8 img.tga\nprintf '\\n=3=\\n'\n/usr/bin/python3 setpx.py 0 0",
      "steps": [
        {
          "expect": "\\x1bPq\"1;1;640;1120#0;2;0;0;0"
        },
        {
          "expect": "=1="
        },
        {
          "expect": "\\x1bPq\"1;1;640;10#0;2;0;0;0"
        },
        {
          "expect": "=2="
        },
        {
          "expect": "\\x1bPq\"1;1;8;14#0;2;0;0;0"
        },
        {
          "expect": "=3="
        }
      ],
      "expected_status": 0
    },
    {
      "id": "migration-sixel-zero-pixel-fallback",
      "loadable": "sixel",
      "group": "terminal",
      "driver": "pty",
      "kind": "contract",
      "covers": [
        "sixel/resize-and-terminal-defaults"
      ],
      "purpose": "With zero terminal pixel sizes, a 1000x1 image falls back to the documented 800 px width (height kept by aspect, clamped to 1); with stdout redirected to a file the same fallback applies even though the terminal reports 640 px",
      "oracle": "contract: sixel help text ('-w N output width in pixels (default: terminal px, else 800)', '-H N output height in pixels (default: keep aspect)') and DEC sixel raster attributes \"Pan;Pad;Ph;Pv; the 'else 800' fallback is asserted only for an image wider than 800 px, where the help text and the code (iw < 800 ? iw : 800) agree",
      "comparison": "exact raster-attribute bytes in the raw PTY output; exact marker for the header of the redirected file",
      "requires": [
        "python3"
      ],
      "timeout": 20,
      "files": {
        "img.tga": {
          "base64": "AAACAAAAAAAAAAAABAAHABggAAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/"
        },
        "wide.tga": {
          "base64": ""
        },
        "setpx.py": "import fcntl, os, struct, sys, termios\nfd = os.open('/dev/tty', os.O_RDWR | os.O_NOCTTY)\nfcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', 24, 80, int(sys.argv[1]), int(sys.argv[2])))\nos.close(fd)\n"
      },
      "script": "/usr/bin/python3 setpx.py 0 0\nsixel wide.tga\nprintf '\\n=1=\\n'\n/usr/bin/python3 setpx.py 640 384\nsixel wide.tga > o.six\nh=$(<o.six)\n[[ $h == $'\\ePq\"1;1;800;1#'* ]] && echo nontty-800x1 > marker || echo other > marker\nrm -f o.six\n/usr/bin/python3 setpx.py 0 0",
      "steps": [
        {
          "expect": "\\x1bPq\"1;1;800;1#0;2;0;0;0"
        },
        {
          "expect": "=1="
        }
      ],
      "expected_status": 0,
      "expected_files": {
        "marker": "nontty-800x1\n"
      }
    }
  ]
}
