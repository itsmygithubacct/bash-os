      "kind": "contract",
      "purpose": "Independently verify failed saved-set restoration leaves kernel set and rule state unchanged.",
      "covers": [
        "fw/deferred_sets_persistence_roundtrip"
      ],
      "oracle": "Real guest ipset and iptables-save observations before and after a deliberately invalid saved member or an injected second swap failure.",
