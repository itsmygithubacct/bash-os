        "unshare",
        "python3",
        "iptables",
        "ipset"
      ],
      "features": [
        "userns"
      ],
      "candidate_script": "exec /usr/bin/unshare --user --map-root-user --net --mount --uts /usr/bin/python3 -I /opt/bashos-parity/harness/helpers/review-fw-staged-ipset-r1.py malformed\n",
      "stdout": "staged ipset malformed checks passed\n",
      "expected_status": 0,
