# config/bash-loadables.list — loadables compiled into bash-os as static
# builtins. NAME[|short-doc], one per line; '#' comments, blanks ignored
# (config/loadables.sh is the one parser). A NAME resolves to loadables/NAME.c
# in this repo, or to bash's own examples/loadables/NAME.c from the pinned
# tarball (the stock set). build.sh injects them; num_shell_builtins self-sizes.
#
# Curated 2026-09-05 from the lichee-nano-bashos appliance's inject list, with
# the four board-coupled managers (bashnpu, bashyolox, bashrtsp, detectlog)
# left in that project. 127 entries. See docs/PROVENANCE.md.

basename|basename
cat|cat
chmod|chmod
cut|cut
dirname|dirname
head|head
id|id
ln|ln
logname|logname
mkdir|mkdir
mkfifo|mkfifo
mktemp|mktemp
pathchk|pathchk
printenv|printenv
realpath|realpath
rm|rm
rmdir|rmdir
seq|seq
sleep|sleep
stat|stat
strftime|strftime
strptime|strptime
sync|sync
tee|tee
tty|tty
uname|uname
unlink|unlink
whoami|whoami
fdflags|fdflags
finfo|finfo
fltexpr|fltexpr
getconf|getconf
setpgid|setpgid
bashio|bashio
bashpoll|bashpoll
bashinotify|bashinotify
bashclock|bashclock
bashjson|bashjson
binhex|binhex
bashbase64|bashbase64
bashtermraw|bashtermraw
bashkmod|bashkmod
bashmount|bashmount
bashlogger|bashlogger
bashsyslogd|bashsyslogd
ls|ls [OPTION]... [FILE]...
cp|cp [-r] SRC... DST
mv|mv SRC... DST
touch|touch FILE...
find|find [PATH] [EXPR]
sed|sed [OPTION] SCRIPT [FILE]
sort|sort [OPTION] [FILE]
tail|tail [-n N] [-f] [FILE]
wc|wc [-clw] [FILE]
readlink|readlink [-f] FILE
ps|ps snapshot of processes
free|free memory summary
dd|dd if= of= ...
df|df [FILE]
du|du [FILE]
reboot|reboot the system
halt|halt the system
poweroff|power off the system
chown|chown OWNER[:GROUP] FILE...
rngseed|Credit and refresh the kernel random seed
rtspcat|RTSP/RTP H.264 client, access units out as framed records
httpd|HTTP server primitive: listen, accept one request, reply
chgrp|chgrp GROUP FILE...
tr|tr
uniq|uniq
nl|nl
od|od
cmp|cmp
date|date
env|env
xargs|xargs
truncate|truncate
hostname|hostname
rev|rev
fold|fold
comm|comm
paste|paste [-d LIST] FILE...
pgrep|pgrep PATTERN
pidof|pidof NAME
killall|killall NAME
killall5|killall5 -SIG
pkill|pkill PATTERN
grep|grep [-EFivwcnrl] PATTERN [FILE]
ip|ip addr|link|route ...
bashdhcp|DHCPv4 client (RFC2131 DISCOVER/OFFER/REQUEST/ACK + parse-message)
nice|nice [-n N] CMD
nohup|nohup CMD
link|link TARGET NAME
blkid|blkid [DEV]
lsblk|lsblk
diff|diff A B
ss|ss [-tuln]
netstat|netstat -tuln (via ss backend)
ping|ping [-c N] HOST

# archives
pax|POSIX pax ustar archives: list, -w create, -r extract, -rw copy

# compression (libzstd loaded at run time; no link-time dependency)
zstd|Compress or decompress files with zstd
zstdcat|Decompress zstd files to standard output

# util-linux family (imported 2026-09-06 from the upstream collection)
flock|Manage advisory file locks via flock(2)
setsid|Run a program in a new session
ionice|Get or set the I/O scheduling class and priority of a process
blockdev|Call block-device ioctls from the command line
ipcmk|Create System V IPC resources
ipcctl|Run gated System V IPC control operations
chattr|Change file attributes on a Linux filesystem
lsattr|List file attributes on a Linux filesystem
mkswap|Set up a Linux swap area
swapon|Enable a swap area, or list the active ones
swapoff|Disable a swap area
wipefs|Detect or wipe filesystem / swap signatures
fincore|Count pages of a file resident in core (the page cache)
fsfreeze|Suspend or resume access to a filesystem
losetup|Set up and control loop devices
dmsetup|Low-level device-mapper control
getfacl|Display POSIX.1e file access control lists
setfacl|Set POSIX.1e file access control lists
fstrim|Discard unused blocks on a mounted filesystem
prlimit|prlimit(8) subset over prlimit(2)
hwclock|hwclock(8) subset over /dev/rtc0
renice|Change the niceness of running processes (POSIX renice)
taskset|Run or query commands with a CPU affinity mask
chrt|Show or change process scheduling policy and priority
uclampset|Show process utilization clamp values through sched_getattr(2)
