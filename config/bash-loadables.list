# config/bash-loadables.list — loadables compiled into bash-os as static
# builtins. NAME[|short-doc], one per line; '#' comments, blanks ignored
# (config/loadables.sh is the one parser). A NAME resolves to loadables/NAME.c
# in this repo, or to bash's own examples/loadables/NAME.c from the pinned
# tarball (the stock set). build.sh injects them; num_shell_builtins self-sizes.
#
# Curated 2026-09-05 from the lichee-nano-bashos appliance's inject list, with
# the four board-coupled managers (bashnpu, bashyolox, bashrtsp, detectlog)
# left in that project. 99 entries. See docs/PROVENANCE.md.

basename|basename
cat|cat
chmod|chmod
cut|cut
dirname|dirname
head|head
id|id
ln|ln
logname|logname
mkdir|mkdir
mkfifo|mkfifo
mktemp|mktemp
pathchk|pathchk
printenv|printenv
realpath|realpath
rm|rm
rmdir|rmdir
seq|seq
sleep|sleep
stat|stat
strftime|strftime
