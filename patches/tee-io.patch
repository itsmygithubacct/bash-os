+  while (1)
+    {
+      nr = read (0, buf, TEE_BUFSIZE);
+      if (nr < 0 && errno == EINTR)
+        {
+          QUIT;
+          continue;
+        }
+      if (nr <= 0)
+        break;
+
+      int live = 0;
+      for (fl = tee_flist; fl; fl = fl->next)
