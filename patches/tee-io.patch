+/* Index of NAME[0..LEN) in the NULL-terminated TABLE: exact or unique
+   prefix; -1 none, -2 ambiguous. */
+static int
+tee_match (const char *const *table, const char *name, size_t len)
+{
+  int found = -1, count = 0;
+  for (int i = 0; table[i]; i++)
+    if (!strncmp (table[i], name, len))
+      {
+	if (strlen (table[i]) == len)
+	  return i;
+	found = i;
+	count++;
+      }
+  return count > 1 ? -2 : found;
+}
