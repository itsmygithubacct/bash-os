+/* coreutils' "invalid time interval 'X'" for one operand. */
+static void
+sleep_invalid (const char *arg)
+{
+  char *quoted = bos_quote (arg);
+
+  builtin_error ("invalid time interval %s", quoted ? quoted : arg);
+  free (quoted);
+}
 
 #define S_SEC	1
