+      sec = usec = 0;
+      r = *arg && *arg != '-' ? uconvert (arg, &sec, &usec, &ep) : 0;
+      if (*arg && *arg != '-' && r == 0 && (strchr ("dhms", *ep) || strpbrk (arg, "dhms")))
+        r = parse_gnutimefmt (arg, &sec, &usec);
+      if (r == 0 || sec < 0 || usec < 0 || sec > LONG_MAX - total_sec)
+        { sleep_invalid (arg); bad = 1; continue; }
+      total_sec += sec;
+      total_usec += usec;
+      if (total_usec >= 1000000)
