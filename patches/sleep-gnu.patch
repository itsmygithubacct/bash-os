+  long sec, usec, total_sec = 0, total_usec = 0;
+  char *ep, *arg;
+  WORD_LIST *word;
+  int r, options = 1, bad = 0;
+  SHELL_VAR *posix_var = find_variable ("POSIXLY_CORRECT");
+  int posix = posix_var && exported_p (posix_var);
+
+  /* Options first, wherever they are, as getopt permutes: only --help and
+     --version (or a prefix of them) exist; "--" ends the options; any
+     other word starting with '-' (except "-" itself) is a usage error. */
+  for (word = list; word; word = word->next)
+    {
+      arg = word->word->word;
+      if (options && strcmp (arg, "--") == 0)
+        { options = 0; continue; }
+      if (!options || arg[0] != '-' || arg[1] == 0)
+        {
+          if (posix) options = 0;
+          continue;
+        }
+      if (arg[1] == '-')
+        {
+          size_t length = strcspn (arg + 2, "=");
+          const char *name = 0;
+
+          if (length && length <= 4 && strncmp (arg + 2, "help", length) == 0)
+            name = "help";
+          else if (length && length <= 7 && strncmp (arg + 2, "version", length) == 0)
+            name = "version";
+          if (name && arg[2 + length])
+            {
+              builtin_error ("option '--%s' doesn't allow an argument", name);
+              bos_shim_try_help ("sleep");
+              return EXECUTION_FAILURE;
+            }
+          if (name && *name == 'h')
+            { builtin_help (); return sh_chkwrite (EXECUTION_SUCCESS); }
+          if (name)
+            { printf ("sleep (bash-os builtin)\n"); return sh_chkwrite (EXECUTION_SUCCESS); }
