+#if defined (LOCALE_NAMES_CHECK)
+/* With an explicit FORMAT, glibc strptime also takes the C locale's English
+   month and weekday names in another LC_TIME locale.  Python's
+   datetime.strptime, the reference for localized parsing, takes only the
+   current locale's names, so a parse is kept only when every month and
+   weekday directive consumed one of those. */
+
+/* P points at a '%'; return the conversion character after the flags,
+   field width and E or O modifier that glibc strptime discards. */
+static const char *
+directive_conversion (const char *p)
+{
+  p++;
+  while (*p && strchr ("-_0^#", *p))
+    p++;
+  while (*p >= '0' && *p <= '9')
+    p++;
+  if (*p == 'E' || *p == 'O')
+    p++;
+  return p;
+}
+
+/* The locale formats glibc substitutes for %c, %x, %X and %r. */
+static const char *
+composite_format (int conv, int era)
+{
+  const char *f;
+
+  switch (conv)
+    {
+    case 'c':
+      f = era ? nl_langinfo (ERA_D_T_FMT) : "";
+      return *f ? f : nl_langinfo (D_T_FMT);
+    case 'x':
+      f = era ? nl_langinfo (ERA_D_FMT) : "";
+      return *f ? f : nl_langinfo (D_FMT);
+    case 'X':
+      f = era ? nl_langinfo (ERA_T_FMT) : "";
+      return *f ? f : nl_langinfo (T_FMT);
+    case 'r':
+      return nl_langinfo (T_FMT_AMPM);
+    }
+  return 0;
+}
+
+static void
+append_bytes (char **buf, size_t *len, size_t *size, const char *s, size_t n)
+{
+  if (*len + n + 1 > *size)
+    {
+      *size = *len + n + 1 + 64;
+      *buf = xrealloc (*buf, *size);
+    }
+  memcpy (*buf + *len, s, n);
+  *len += n;
+  (*buf)[*len] = 0;
+}
+
+/* FORMAT with its composite directives replaced by the locale's formats,
+   so the names inside them are checked too. */
+static char *
+expand_format (const char *format)
+{
+  size_t len = 0, size = strlen (format) + 1;
+  char *r = xmalloc (size);
+  const char *p, *c, *sub;
+
+  r[0] = 0;
+  for (p = format; *p; )
+    {
+      if (*p != '%')
+	{
+	  append_bytes (&r, &len, &size, p++, 1);
+	  continue;
+	}
+      c = directive_conversion (p);
+      sub = *c ? composite_format (*c, c[-1] == 'E') : 0;
+      if (sub)
+	append_bytes (&r, &len, &size, sub, strlen (sub));
+      else
+	append_bytes (&r, &len, &size, p, c - p + (*c != 0));
+      p = c + (*c != 0);
+    }
+  return r;
+}
+
+/* Whether the input from S to E, leading blanks skipped, is NAME, compared
+   without regard to case. */
+static int
+same_name (const char *s, const char *e, const char *name)
+{
+  mbstate_t ms, mn;
+  wchar_t ws, wn;
+  size_t ls, ln;
+
+  while (s < e && isspace ((unsigned char)*s))
+    s++;
+  if (name == 0 || *name == 0 || s == e)
+    return 0;
+  memset (&ms, 0, sizeof (ms));
+  memset (&mn, 0, sizeof (mn));
+  while (s < e && *name)
+    {
+      ls = mbrtowc (&ws, s, e - s, &ms);
+      ln = mbrtowc (&wn, name, strlen (name), &mn);
+      if (ls == 0 || ls >= (size_t)-2 || ln == 0 || ln >= (size_t)-2)
+	{
+	  /* Not a character in LC_CTYPE: compare the byte itself. */
+	  if (tolower ((unsigned char)*s) != tolower ((unsigned char)*name))
+	    return 0;
+	  memset (&ms, 0, sizeof (ms));
+	  memset (&mn, 0, sizeof (mn));
+	  s++, name++;
+	  continue;
+	}
+      if (towlower (ws) != towlower (wn))
+	return 0;
+      s += ls;
+      name += ln;
+    }
+  return s == e && *name == 0;
+}
+
+static int
+locale_name (const char *s, const char *e, int month)
+{
+  static const nl_item months[] = {
+    MON_1, ABMON_1,
+#if defined (ALTMON_1)
+    ALTMON_1,
+#endif
+#if defined (ALTMON_1) && defined (__GLIBC__)
+    _NL_ABALTMON_1,
+#endif
+  };
+  static const nl_item days[] = { DAY_1, ABDAY_1 };
+  const nl_item *items = month ? months : days;
+  size_t i, nitems = month ? sizeof (months) / sizeof (months[0]) : 2;
+  int n, count = month ? 12 : 7;
+
+  for (i = 0; i < nitems; i++)
+    for (n = 0; n < count; n++)
+      if (same_name (s, e, nl_langinfo (items[i] + n)))
+	return 1;
+  return 0;
+}
+
+/* Parse the format up to and through each month or weekday directive;
+   glibc strptime converts left to right, so the input between the two
+   end points is what that directive consumed. */
+static int
+locale_names_ok (const char *input, const char *format, const struct tm *initial)
+{
+  const char *lt, *p, *c, *from, *to;
+  char *fmt, *part;
+  struct tm t;
+  int ok;
+
+  lt = setlocale (LC_TIME, NULL);
+  if (lt == 0 || STREQ (lt, "C") || STREQ (lt, "POSIX"))
+    return 1;
+  fmt = expand_format (format);
+  part = xmalloc (strlen (fmt) + 1);
+  ok = 1;
+  for (p = fmt; ok && *p; p++)
+    {
+      if (*p != '%')
+	continue;
+      c = directive_conversion (p);
+      if (*c == 0)
+	break;
+      if (strchr ("aAbBh", *c))
+	{
+	  memcpy (part, fmt, p - fmt);
+	  part[p - fmt] = 0;
+	  t = *initial;
+	  from = strptime (input, part, &t);
+	  memcpy (part, fmt, c + 1 - fmt);
+	  part[c + 1 - fmt] = 0;
+	  t = *initial;
+	  to = from ? strptime (input, part, &t) : 0;
+	  ok = to && to > from && locale_name (from, to, *c != 'a' && *c != 'A');
+	}
+      p = c;
+    }
+  free (part);
+  free (fmt);
+  return ok;
 }
+#endif /* LOCALE_NAMES_CHECK */
 
