 #include "bashgetopt.h"
 
+extern char *this_command_name;
+
+static void
+basename_print (const char *path, const char *suffix, int eol)
+{
+  size_t end = strlen (path), start, n;
+  while (end && path[end - 1] == '/') end--;
+  if (!end && *path) { fputs ("/", stdout); putchar (eol); return; }
+  start = end;
+  while (start && path[start - 1] != '/') start--;
+  n = end - start;
+  if (suffix) {
+    size_t len = strlen (suffix);
+    if (len < n && !memcmp (path + end - len, suffix, len)) n -= len;
+  }
+  fwrite (path + start, 1, n, stdout);
+  putchar (eol);
+}
+
+/* GNU basename's long options, matched by any unambiguous prefix. */
+static const char *const basename_longopts[] = { "multiple", "suffix", "zero", "help", 0 };
+
+static void
+basename_try_help (void)
+{
+  fprintf (stderr, "Try '%s --help' for more information.\n", this_command_name);
+}
