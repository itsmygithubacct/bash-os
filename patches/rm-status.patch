+/* -v: GNU's "removed 'NAME'" lines, names in the always-quoted shell style. */
+static void
+rm_report (int directory, const char *name)
+{
+  char *quoted;
+
+  if (rm_verbose == 0)
+    return;
+  quoted = bos_quoteaf (name);
+  if (quoted == 0)
+    return;
+  printf ("removed %s%s\n", directory ? "directory " : "", quoted);
+  fflush (stdout);
+  free (quoted);
+}
+
+/* GNU rm -f ignores only operands that do not exist; any other failure,
+   such as EPERM in a sticky directory or EACCES in a read-only one, is
+   still "cannot remove 'NAME': ..." and status 1. */
+static int
+rm_missing_errno (int errnum)
+{
+  return errnum == ENOENT || errnum == ENOTDIR || errnum == EINVAL || errnum == EILSEQ;
+}
+
+static int
+rm_fail (const char *fname, int errnum)
+{
+  char *quoted;
+
+  if (force && rm_missing_errno (errnum))
+    return 0;
+  quoted = bos_quoteaf (fname);
+  builtin_error ("cannot remove %s: %s", quoted ? quoted : fname, strerror (errnum));
+  free (quoted);
+  return 1;
+}
