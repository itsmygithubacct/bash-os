+/* A redirection is about to open FILENAME in this child. Opening a FIFO
+   waits for its other end, which the parent may open only after it
+   returns from the handshake wait (cmd < fifo & exec 9> fifo), so release
+   the parent first. */
+void
+bashos_release_async_exec_for (const char *filename)
+{
+  struct stat finfo;
+
+  if (bashos_async_exec_fd >= 0 && filename &&
+      stat (filename, &finfo) == 0 && S_ISFIFO (finfo.st_mode))
+    bashos_release_async_exec ();
+}
