+/* GNU's default permits a missing final component, including the target of
+   a dangling final symlink. Resolve every parent before accepting that leaf. */
+static char *
+realpath_leaf (const char *path, unsigned int links)
+{
+  char *resolved, *copy, *slash, *leaf, *parent, *joined, *target, link[PATH_MAX + 1];
+  struct stat st;
+  size_t length;
+  ssize_t count;
+  int error;
+
+  resolved = realpath (path, 0);
+  if (resolved || errno != ENOENT || *path == 0) return resolved;
+  if (links >= 40) { errno = ELOOP; return 0; }
+  copy = savestring (path);
+  length = strlen (copy);
+  while (length > 1 && copy[length - 1] == '/') copy[--length] = 0;
+  slash = strrchr (copy, '/');
+  leaf = slash ? slash + 1 : copy;
+  if (STREQ (leaf, ".") || STREQ (leaf, ".."))
+    { free (copy); errno = ENOENT; return 0; }
+  if (slash) *slash = 0;
+  parent = realpath (slash ? (slash == copy ? "/" : copy) : ".", 0);
+  if (parent == 0) { free (copy); return 0; }
+  if (stat (parent, &st) < 0 || !S_ISDIR (st.st_mode))
+    { free (parent); free (copy); errno = ENOTDIR; return 0; }
+  joined = sh_makepath (parent, leaf, 0);
+  free (copy);
+  if (lstat (joined, &st) == 0)
+    {
+      if (S_ISLNK (st.st_mode))
+        {
+          count = readlink (joined, link, sizeof link - 1);
+          error = errno;
+          if (count < 0)
+            { free (joined); free (parent); errno = error; return 0; }
+          if (count == sizeof link - 1)
+            { free (joined); free (parent); errno = ENAMETOOLONG; return 0; }
+          link[count] = 0;
+          target = make_absolute (link, parent);
+          free (joined);
+          joined = realpath_leaf (target, links + 1);
+          free (target);
+        }
+    }
+  else if (errno != ENOENT)
+    { error = errno; free (joined); joined = 0; errno = error; }
+  free (parent);
+  return joined;
+}
+
+static char *
+realpath_lexical (const char *path)
+{
+  char *cwd, *absolute, *p, *result;
+  struct stat st;
+  int error;
+
+  if (*path == 0) { errno = ENOENT; return 0; }
+  cwd = getcwd (0, 0);
+  if (cwd == 0) return 0;
+  absolute = make_absolute ((char *)path, cwd);
+  free (cwd);
+  /* A nonexistent prefix is allowed in -s mode, but an existing regular
+     file cannot serve as a directory. Keep dot-dot existence checks too. */
+  for (p = absolute + 1; *p; p++)
+    if (*p == '/' && p[-1] != '/')
+      {
+        *p = 0;
+        if (stat (absolute, &st) == 0)
+          {
+            if (!S_ISDIR (st.st_mode))
+              { free (absolute); errno = ENOTDIR; return 0; }
+          }
+        else if (errno != ENOENT)
+          { error = errno; free (absolute); errno = error; return 0; }
+        *p = '/';
+      }
+  result = sh_canonpath (absolute, PATH_CHECKDOTDOT);
+  free (absolute);
+  if (result && result[0] == '/' && result[1] == '/')
+    memmove (result, result + 1, strlen (result));
+  return result;
+}
+
+/* Resolve symlinks as components are encountered so a subsequent ".."
+   applies to the link target. In missing mode every other component is
+   accepted, even below a nonexistent or nondirectory parent. */
+typedef struct rp_frame {
+  char *text, *rest, *link_path;
+  struct rp_frame *parent;
+} rp_frame;
+
+static char *
+realpath_missing (const char *path, int physical)
+{
+  char *base, *part;
+  rp_frame start, *frame = &start;
+  if (!*path) { errno = ENOENT; return 0; }
+  base = *path == '/' ? savestring ("/") : getcwd (0, 0);
+  if (!base) return 0;
+  start.text = start.rest = savestring (path);
+  start.link_path = 0;
+  start.parent = 0;
+  while (frame) {
+    char *next;
+    part = strsep (&frame->rest, "/");
+    if (!part) {
+      rp_frame *parent = frame->parent;
+      free (frame->text);
+      free (frame->link_path);
+      if (parent) free (frame);
+      frame = parent;
+      continue;
+    }
+    if (!*part || STREQ (part, ".")) continue;
+    if (STREQ (part, "..")) {
+      char *last = strrchr (base, '/');
+      if (last != base) *last = 0;
+      else base[1] = 0;
+      continue;
+    }
+    next = sh_makepath (base, part, 0);
+    if (physical) {
+      char link[PATH_MAX + 1];
+      ssize_t n = readlink (next, link, sizeof link - 1);
+      if (n > 0) {
+        rp_frame *seen;
+        for (seen = frame; seen->link_path; seen = seen->parent)
+          if (STREQ (seen->link_path, next)) break;
+        if (!seen->link_path) {
+          rp_frame *target = xmalloc (sizeof *target);
+          link[n] = 0;
+          target->text = target->rest = savestring (link);
+          target->link_path = next;
+          target->parent = frame;
+          frame = target;
+          if (link[0] == '/') base[1] = 0;
+          continue;
+        }
+      }
+    }
+    free (base);
+    base = next;
+  }
+  return base;
+}
+
+/* Canonicalize P in the selected mode: -e/-c every component exists,
+   default the last may be missing, -m any may be; -s lexical; -L applies
+   ".." before resolving symlinks. Returns allocated text or 0 (errno). */
+static char *
+realpath_canon (const char *p, int mflag, int cflag, int sflag, int lflag)
+{
+	char *r, *cwd, *lex;
+	struct stat sb;
+
+	if (lflag && !sflag && *p) {
+		cwd = getcwd (0, 0);
+		if (cwd == 0) return 0;
+		lex = make_absolute ((char *)p, cwd);
+		free (cwd);
+		r = sh_canonpath (lex, 0);
+		free (lex);
+		if (r == 0) { errno = ENOENT; return 0; }
+		lex = r;
+		r = mflag ? realpath_missing (lex, 1) : realpath_leaf (lex, 0);
+		free (lex);
+	} else if (mflag)
+		r = realpath_missing (p, !sflag);
+	else
+		r = sflag ? realpath_lexical (p) : realpath_leaf (p, 0);
+	if (r && cflag && stat (r, &sb) < 0) {
+		int error = errno;
+		free (r);
+		errno = error;
+		return 0;
+	}
+	return r;
+}
+
+/* GNU path_prefix: PREFIX names PATH or one of its ancestors. */
+static int
+realpath_prefix (const char *prefix, const char *path)
+{
+	size_t n = strlen (prefix);
+	if (STREQ (prefix, "/")) return 1;
+	return strncmp (prefix, path, n) == 0 && (path[n] == '/' || path[n] == 0);
+}
+
+/* PATH relative to directory DIR, both canonical and absolute. */
+static char *
+realpath_relative (const char *path, const char *dir)
+{
+	const char *p = path, *d = dir, *q;
+	size_t up = 0, pl, dl, i, len;
+	char *out;
+
+	/* Skip the common leading components. */
+	for (;;) {
+		while (*p == '/') p++;
+		while (*d == '/') d++;
+		pl = strcspn (p, "/");
+		dl = strcspn (d, "/");
+		if (pl == 0 || pl != dl || strncmp (p, d, pl) != 0)
+			break;
+		p += pl;
+		d += dl;
+	}
+	for (q = d; *q; ) {
+		while (*q == '/') q++;
+		if (*q == 0) break;
+		up++;
+		q += strcspn (q, "/");
+	}
+	out = xmalloc (up * 3 + strlen (p) + 2);
+	out[0] = 0;
+	for (i = 0; i < up; i++)
+		strcat (out, "../");
+	strcat (out, p);
+	len = strlen (out);
+	if (len > 1 && out[len - 1] == '/')
+		out[len - 1] = 0;
+	if (*out == 0)
+		strcpy (out, ".");
+	return out;
+}
