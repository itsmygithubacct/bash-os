+/* A file name in a diagnostic, quoted only when a reader needs it. */
+static void
+realpath_file_error (const char *name, int error)
+{
+	char *q = bos_quotef (name);
+	builtin_error ("%s: %s", q ? q : name, strerror (error));
+	free (q);
+}
