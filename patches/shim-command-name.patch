 int gnu_error_format = 0;
 
+/* bash-os: the /bin/<cmd> shim runs a builtin as a standalone command.
+   Just before `builtin BUILTIN ARGS' it sets the shell variable
+   BASHOS_SHIM_COMMAND to BUILTIN=NAME, where NAME is the command name the
+   program was started as. While it is set, diagnostics read as the
+   standalone tool's would: they start with "NAME: " instead of the script
+   name and line number, and the builtin BUILTIN calls itself NAME (other
+   builtins it runs keep their own names). An exported or non-scalar value
+   is ignored, so the setting never reaches a child shell through the
+   environment, and ordinary scripts keep bash's messages. */
+static const char *
+bashos_shim_value (size_t *targetlen)
+{
+  SHELL_VAR *v;
+  char *value, *eq;
+
+  if (shell_variables == 0)
+    return ((char *)NULL);
+  v = find_variable_noref ("BASHOS_SHIM_COMMAND");
+  if (v == 0 || exported_p (v) || invisible_p (v) || array_p (v) || assoc_p (v) || nameref_p (v))
+    return ((char *)NULL);
+  value = value_cell (v);
+  if (value == 0 || (eq = strchr (value, '=')) == 0 || eq == value || eq[1] == '\0')
+    return ((char *)NULL);
+  *targetlen = eq - value;
+  return (value);
+}
+
+const char *
+bashos_shim_display (void)
+{
+  const char *value;
+  size_t len;
+
+  value = bashos_shim_value (&len);
+  return (value ? value + len + 1 : (char *)NULL);
+}
+
+int
+bashos_shim_runs (const char *cmd)
+{
+  const char *value;
+  size_t len;
+
+  value = bashos_shim_value (&len);
+  return (value && cmd && strncmp (value, cmd, len) == 0 && cmd[len] == '\0');
+}
+
+const char *
+bashos_shim_name (const char *cmd)
+{
+  return (bashos_shim_runs (cmd) ? bashos_shim_display () : cmd);
+}
+
 static void
 error_prolog (int print_lineno)
 {
   char *ename;
+  const char *shim;
   int line;
 
+  shim = bashos_shim_display ();
+  if (shim)
+    {
+      fprintf (stderr, "%s: ", shim);
+      return;
+    }
+
   ename = get_name_for_error ();
   line = (print_lineno && interactive_shell == 0) ? executing_line_number () : -1;
 
