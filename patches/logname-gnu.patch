+/* The login name, as GNU logname reports it: the user of the audit login
+   UID (/proc/self/loginuid, set by the login session and inherited from
+   there), else the user of the utmp login record for the terminal on
+   standard input. Never LOGNAME or USER, which a C library's getlogin()
+   may consult (musl does). Returns NULL when there is no login name. */
+static const char *
+logname_lookup (void)
+{
+  static char user[UT_NAMESIZE + 1];
+  /* bash-os login writes /var/run/utmp; some systems keep /run/utmp apart. */
+  static const char *const utmp_files[] = { "/var/run/utmp", "/run/utmp", 0 };
+  struct passwd *pw;
+  struct utmp u;
+  char buffer[32], *end, *line;
+  const char *const *f;
+  unsigned long long uid;
+  ssize_t n;
+  size_t used;
+  int fd;
+
+  fd = open ("/proc/self/loginuid", O_RDONLY | O_CLOEXEC);
+  if (fd >= 0)
+    {
+      n = read (fd, buffer, sizeof buffer - 1);
+      close (fd);
+      if (n > 0)
+        {
+          buffer[n] = 0;
+          errno = 0;
+          uid = strtoull (buffer, &end, 10);
+          /* (uid_t)-1 means the process was never part of a login. */
+          if (errno == 0 && end != buffer && (*end == 0 || *end == '\n') &&
+              uid == (unsigned long long)(uid_t)uid && (uid_t)uid != (uid_t)-1 &&
+              (pw = getpwuid ((uid_t)uid)) && pw->pw_name && *pw->pw_name)
+            return pw->pw_name;
+        }
+    }
+
+  line = ttyname (STDIN_FILENO);
+  if (line == 0)
+    return 0;
+  if (strncmp (line, "/dev/", 5) == 0)
+    line += 5;
+  for (f = utmp_files; *f; f++)
+    {
+      fd = open (*f, O_RDONLY | O_CLOEXEC);
+      if (fd < 0)
+        continue;
+      for (;;)
+        {
+          for (used = 0; used < sizeof u; used += n)
+            {
+              n = read (fd, (char *)&u + used, sizeof u - used);
+              if (n < 0 && errno == EINTR) { n = 0; continue; }
+              if (n <= 0) break;
+            }
+          if (used < sizeof u)
+            break;
+          if (u.ut_type == USER_PROCESS && u.ut_user[0] &&
+              strncmp (u.ut_line, line, sizeof u.ut_line) == 0)
+            {
+              close (fd);
+              memcpy (user, u.ut_user, UT_NAMESIZE);
+              user[UT_NAMESIZE] = 0;
+              return user;
+            }
+        }
+      close (fd);
+    }
+  return 0;
+}
