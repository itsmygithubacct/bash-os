+/* Write end, in the child, of the async exec handshake. Close-on-exec
+   drops it when execve succeeds. The child closes it before an in-process
+   builtin or before a script keeps running as this shell. -1 when this
+   process is not holding one. */
+static int bashos_async_exec_fd = -1;
+
+/* Read end, in the parent. stop_pipeline waits on it after the
+   process-group pipe is closed, so the wait cannot deadlock with that
+   pipe. -1 when no handshake is armed. */
+static int bashos_async_exec_wait_fd = -1;
+
+static void
+bashos_release_async_exec (void)
+{
+  if (bashos_async_exec_fd >= 0)
+    {
+      close (bashos_async_exec_fd);
+      bashos_async_exec_fd = -1;
+    }
+}
+
+void
+bashos_wait_async_exec (void)
+{
+  char ignored;
+  ssize_t n;
+  int fd;
+
+  fd = bashos_async_exec_wait_fd;
+  if (fd < 0)
+    return;
+  bashos_async_exec_wait_fd = -1;
+  do
+    n = read (fd, &ignored, 1);
+  while (n > 0 || (n < 0 && errno == EINTR));
+  close (fd);
+}
+
