  "remaining_blockers": [
    {
      "topic": "auth/authority-policy-audit-and-child-flow",
      "category": "kernel-authority-absent",
      "reason": "Request-digest binding, audit decoding and child-status handling are produced by the real /dev/bashos-auth kernel authority, which is absent in the guest; a synthetic device cannot stand in for them."
    },
    {
      "topic": "auth/device-abi-and-fd-lifecycle",
      "category": "kernel-authority-absent",
      "reason": "Close-time clearing of secret slots is performed by the real /dev/bashos-auth kernel authority, which is absent in the guest."
    },
    {
      "topic": "auth/pty-sealed-secret-lifecycle",
      "category": "kernel-authority-absent",
      "reason": "In-kernel slot comparison and clear/close cleanup are performed by the real /dev/bashos-auth kernel authority, which is absent in the guest."
    },
    {
      "topic": "auth/synthetic-login-and-token-mint",
      "category": "kernel-authority-absent",
      "reason": "Token-reference minting and binding are performed by the real /dev/bashos-auth kernel authority, which is absent in the guest; the synthetic mint's reference semantics are not the contract."
    },
    {
      "topic": "bashpoll/signalfd-ownership",
      "category": "unreachable-on-frozen-build",
      "reason": "bashpoll is compiled into both candidate builds; enable -d fails with \"not dynamically loaded\", so the unload hook cannot be reached."
    },
    {
      "topic": "dmesg/live-ring-buffer",
      "category": "interface-cannot-represent",
      "reason": "The kernel truncates records written to /dev/kmsg to about 1 KiB, so no record near the 8192-byte read size can exist on the live ring; that boundary is exercised only through the fixture-file path (legacy/dmesg/split-read-boundary)"
    },
    {
      "topic": "doas/authority_policy_and_verification",
      "category": "kernel-authority-absent",
      "reason": "The observable is produced by the real /dev/bashos-auth kernel authority (v2 allow, policy deny, non-interactive denial and verifier outcomes are decided by it); no guest kernel provides that device and a synthetic stand-in would not be the authority's answer."
    },
    {
      "topic": "login/credential-transition-deferred",
      "category": "kernel-authority-absent",
      "reason": "Token acceptance (--auth-fd CONSUME, --auth-token) is decided by the real /dev/bashos-auth kernel authority (BL_AUTH_IOC_MINT/CONSUME); no guest kernel provides that device and a synthetic stand-in would not be the authority's answer."
    },
    {
